{
  "name": "jonjon1992/s3-php",
  "version":"3.1.0",
  "description": "Uma biblioteca PHP simples e eficiente para trabalhar com Amazon S3",
  "keywords": ["aws", "s3", "amazon", "storage", "php"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "aws/aws-sdk-php": "^3.402",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "infection/infection": "^0.29 || ^0.35",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
    "rector/rector": "^2.8",
    "squizlabs/php_codesniffer": "^4.0",
    "vimeo/psalm": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "S3\\Lib\\": "lib"
    },
    "files": [
      "lib/helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "process-timeout": 0,
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices",
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage",
    "cs": "phpcs --standard=phpcs.xml",
    "cs-fix": "phpcbf --standard=phpcs.xml",
    "stan": "phpstan analyse",
    "rector": "rector process",
    "infection": "infection",
    "psalm": "psalm",
    "quality": [
      "@cs",
      "@stan",
      "@test"
    ],
    "fix": [
      "@cs-fix",
      "@rector"
    ]
  },
  "extra": {
    "aws/aws-sdk-php": [
      "S3",
      "Sts"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
