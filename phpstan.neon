parameters:
    level: 8
    paths:
        - lib
        - tests
    excludePaths:
        - vendor
    ignoreErrors:
        # Substitui o antigo checkMissingIterableValueType: false (removido no PHPStan 2).
        # A biblioteca não anota genéricos de array em sua API pública.
        - identifier: missingType.iterableValue
    tmpDir: .phpstan
    parallel:
        maximumNumberOfProcesses: 4 